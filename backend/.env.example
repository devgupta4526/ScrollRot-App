# Scrollrot Backend Environment Configuration
# Copy this file to .env and configure secrets locally. Never commit .env to Git.

# Django secret key (generate with: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-50-characters-long

# Set to True for local development only. Must be False on Render/production.
DEBUG=True

# Comma-separated allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# PostgreSQL database connection URL (Postgres or Neon serverless)
# Example for local Postgres: postgresql://scrollrot:password@localhost:5432/scrollrot
# Example for Neon Postgres: postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/scrollrot?sslmode=require
# If left empty in local development (DEBUG=True), a local SQLite fallback is used for testing.
DATABASE_URL=

# CORS allowed origins (optional; native Android Retrofit does not use browser CORS)
CORS_ALLOWED_ORIGINS=
