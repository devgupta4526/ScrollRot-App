<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hudRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Floating Circular Mascot & Badge (Matching BrainPal in-reel overlay) -->
    <LinearLayout
        android:id="@+id/hudBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Mascot Head Circle -->
        <FrameLayout
            android:id="@+id/hudHeadContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_floating_hud_head">

            <TextView
                android:id="@+id/hudEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🧠"
                android:textSize="24sp" />
        </FrameLayout>

        <!-- Count Badge directly attached beneath head -->
        <TextView
            android:id="@+id/hudCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:background="@drawable/bg_floating_hud_badge"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="1dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Tap-Expanded Card Panel -->
    <LinearLayout
        android:id="@+id/hudExpandedPanel"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_modern"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCROLLROT"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/hudProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#262629"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/hudTargetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0 / 100 reels"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/hudPlatformText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="IG: 0 · YT: 0"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/hudDismissText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:text="✕ Dismiss"
            android:textColor="#F43F5E"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
