<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/background"
    android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="26dp" android:paddingBottom="36dp"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="scrollrot." android:fontFamily="sans-serif-black" android:textSize="28sp"
                android:textColor="@color/white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_secondary" android:paddingHorizontal="14dp" android:paddingVertical="9dp"
                android:text="BETA BUILD" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.13"
                android:textColor="@color/accent"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Today is a fresh start."
            android:textColor="@color/muted" android:textSize="15sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:background="@drawable/bg_card"
            android:padding="20dp" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="YOUR SCROLL ENERGY" android:gravity="center"
                android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold"
                android:letterSpacing="0.16"/>
            <com.scrollrot.app.ui.RotCharacterView
                android:id="@+id/mascotView"
                android:layout_width="230dp" android:layout_height="207dp"
                android:layout_marginTop="12dp" android:contentDescription="Animated Scrollrot character"/>
            <TextView android:id="@+id/countText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center" android:text="0"
                android:textColor="@color/white" android:textSize="60sp" android:fontFamily="sans-serif-black"/>
            <TextView android:id="@+id/countLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="reel swipes today (estimated)"
                android:textColor="@color/muted" android:textSize="15sp"/>
            <TextView android:id="@+id/moodText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center" android:text="Looking fresh ✨"
                android:textColor="@color/accent" android:textStyle="bold" android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="DAILY TARGET" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:id="@+id/limitText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="0 / 100 reels" android:textColor="@color/muted" android:textSize="15sp"/>
            <ProgressBar android:id="@+id/limitBar" android:layout_width="match_parent" android:layout_height="8dp"
                style="?android:attr/progressBarStyleHorizontal" android:layout_marginTop="13dp"
                android:progressTint="@color/accent" android:progressBackgroundTint="@color/surface2"
                android:max="100" android:progress="0"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Tracking limit visualization only. Blocking comes later."
                android:textColor="@color/muted" android:textSize="12sp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Where did the scrolls go?"
            android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/appsText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:padding="20dp" android:background="@drawable/bg_card"
            android:text="Instagram · 0\nYouTube · 0\nFacebook · 0\nSnapchat · 0"
            android:textColor="@color/white" android:textSize="16sp" android:lineSpacingExtra="12dp"/>

        <TextView android:id="@+id/permissionStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Tracking permission not enabled"
            android:textColor="@color/muted" android:textSize="14sp"/>
        <Button android:id="@+id/permissionButton" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_button" android:backgroundTint="@null"
            android:text="Enable tracking" android:allCaps="false" android:textStyle="bold"
            android:textColor="@color/background" android:textSize="16sp"/>
        <Button android:id="@+id/demoButton" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null"
            android:text="Preview one reel (demo)" android:allCaps="false"
            android:textColor="@color/white" android:textSize="15sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:gravity="center" android:text="PRIVATE BY DEFAULT  ·  NO LOGIN REQUIRED"
            android:letterSpacing="0.09" android:textColor="@color/muted" android:textSize="10sp"/>
    </LinearLayout>
</ScrollView>
